    {
      "id": "p1-b",
      "type": "text",
      "x": 18,
      "y": 172,
      "width": 496.187744140625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-p1"
      ],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 11,
      "version": 2,
      "versionNonce": 1048473729,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795091834929,
      "link": null,
      "locked": false,
      "text": "Every copy is the same minute of video with one change,\nso the true pulse p is the same in all of them:",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every copy is the same minute of video with one change,\nso the true pulse p is the same in all of them:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p1-f",
      "type": "text",
      "x": 18,
      "y": 222,
      "width": 486.07720947265625,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-p1"
      ],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 12,
      "version": 2,
      "versionNonce": 1128240143,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795091834929,
      "link": null,
      "locked": false,
      "text": "dim, noise, blur, flicker …   p′(t) = p(t)\nplayed k× faster              p′(t) = k · p(k·t)\nstill photo                   no pulse at all",
      "fontSize": 19,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "dim, noise, blur, flicker …   p′(t) = p(t)\nplayed k× faster              p′(t) = k · p(k·t)\nstill photo                   no pulse at all",
      "autoResize": true,
      "lineHeight": 1.25
    },
